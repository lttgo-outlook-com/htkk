<xs:schema xmlns="http://kekhaithue.gdt.gov.vn/TKhaiThue" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://kekhaithue.gdt.gov.vn/TKhaiThue" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:redefine schemaLocation="..\TKhaiThue.xsd">
		<xs:complexType name="CTieuTKhaiChinhType">
			<xs:complexContent>
				<xs:extension base="CTieuTKhaiChinhType">
					<xs:sequence>
						<xs:element name="ThongTinKeKhai">
							<xs:annotation>
								<xs:documentation>Thông tin kê khai</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="DoiTuong">
										<xs:annotation>
											<xs:documentation>Đối tượng kê khai</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="hopTacKD" type="xs:boolean" nillable="true">
													<xs:annotation>
														<xs:documentation>Tổ chức khai thuế thay, nộp thuế thay cá nhân hợp tác kinh doanh với tổ chức </xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="batDongSan" type="xs:boolean" nillable="true">
													<xs:annotation>
														<xs:documentation>Tổ chức khai thuế thay, nộp thuế thay cho cá nhân cho thuê bất động sản</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="ct7" type="xs:long" nillable="true">
										<xs:annotation>
											<xs:documentation>Tổng doanh thu phát sinh trong kỳ (hợp tác KD)</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct8" type="xs:long" nillable="true">
										<xs:annotation>
											<xs:documentation>Tổng số thuế TNCN phải nộp</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct10" type="xs:long" nillable="true">
										<xs:annotation>
											<xs:documentation>Tổng doanh thu phát sinh trong kỳ (BĐS)</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct11" type="xs:long" nillable="true">
										<xs:annotation>
											<xs:documentation>Tổng số thuế GTGT phải nộp</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct12" type="xs:long" nillable="true">
										<xs:annotation>
											<xs:documentation>Tổng số thuế TNCN phải nộp</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
		<xs:complexType name="PLucType">
			<xs:complexContent>
				<xs:extension base="PLucType">
					<xs:sequence>
						<xs:element name="PLuc_HKD_CNKD" minOccurs="0">
							<xs:annotation>
								<xs:documentation>BẢNG KÊ CHI TIẾT HỘ KINH DOANH, CÁ NHÂN KINH DOANH</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="CTietBKeHKD_CNKD" maxOccurs="unbounded">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="ct04" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Họ và tên hộ kinh doanh, cá nhân kinh doanh</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct05" type="TINType" nillable="true">
													<xs:annotation>
														<xs:documentation>Mã số thuế hộ kinh doanh, cá nhân kinh doanh</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct06" type="xs:long" nillable="true">
													<xs:annotation>
														<xs:documentation>Doanh thu</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct07" type="xs:long" nillable="true">
													<xs:annotation>
														<xs:documentation>Số thuế TNCN</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
											<xs:attribute name="id" type="xs:string"/>
										</xs:complexType>
									</xs:element>
									<xs:element name="ct08" type="xs:long" nillable="true">
										<xs:annotation>
											<xs:documentation>Tổng cộng Doanh thu</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct09" type="xs:long" nillable="true">
										<xs:annotation>
											<xs:documentation>Tổng cộng Số thuế TNCN</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="PLuc_CANHAN_TTS" minOccurs="0">
							<xs:annotation>
								<xs:documentation>BẢNG KÊ CHI TIẾT CÁ NHÂN CHO THUÊ TÀI SẢN</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="DiaChi_BDS">
										<xs:annotation>
											<xs:documentation>Đia chỉ bất động sản </xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="ma_xa" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Địa chỉ bất động sản cho thuê: Mã xã/phường/đặc khu</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ten_xa" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Địa chỉ bất động sản cho thuê: Tên Phường/ xã</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ma_tinh" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Địa chỉ bất động sản cho thuê: Mã tỉnh/thành phố</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ten_tinh" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Địa chỉ bất động sản cho thuê: Tên tỉnh/thành phố</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="CTietBKeCNTTS" maxOccurs="unbounded">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="ct05" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Họ và tên bên cho thuê tài sản</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct06" type="TINType" nillable="true">
													<xs:annotation>
														<xs:documentation>Mã số thuế bên cho thuê tài sản</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct07_diaChi" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Địa chỉ bất động sản cho thuê (Số nhà, đường phố/xóm/ấp/ thôn)</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct08" type="xs:long" nillable="true">
													<xs:annotation>
														<xs:documentation>Tổng doanh thu phát sinh trong kỳ </xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct09" type="xs:long" nillable="true">
													<xs:annotation>
														<xs:documentation>Doanh thu được trừ để xác định doanh thu tính thuế</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct10" type="xs:boolean" nillable="true">
													<xs:annotation>
														<xs:documentation>Cá nhân thuộc diện không phải nộp thuế</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct11" type="xs:long" nillable="true">
													<xs:annotation>
														<xs:documentation>Số thuế GTGT phải nộp</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct12" type="xs:long" nillable="true">
													<xs:annotation>
														<xs:documentation>Số thuế TNCN phải nộp</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
											<xs:attribute name="id" type="xs:string"/>
										</xs:complexType>
									</xs:element>
									<xs:element name="tong_doanhThu" type="xs:long" nillable="true">
										<xs:annotation>
											<xs:documentation>Tổng doanh thu trong kỳ</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="tong_duocTru" type="xs:long" nillable="true">
										<xs:annotation>
											<xs:documentation>Doanh thu được trừ để xác định doanh thu tính thuế</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="tong_thueGTGT" type="xs:long" nillable="true">
										<xs:annotation>
											<xs:documentation>Tổng Số thuế GTGT phải nộp</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="tong_thueTNCN" type="xs:long" nillable="true">
										<xs:annotation>
											<xs:documentation>Tổng Số thuế TNCN phải nộp</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:redefine>
</xs:schema>
