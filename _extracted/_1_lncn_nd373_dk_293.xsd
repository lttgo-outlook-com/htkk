									<xs:element name="ct17" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Điện thoại</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct18" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Fax: </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct19" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>E-mail</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="CT20">
										<xs:annotation>
											<xs:documentation>Loại hình ủy quyền</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="donViUyQuyen" type="xs:string" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Đơn vị được uỷ quyền</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="daiLyThue" type="xs:string" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Đại lý thuế </xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="tenDonViUyQuyen" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Tên đơn vị uỷ quyền</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="ten_DonVi" type="xs:string" nillable="true">
							<xs:annotation>
								<xs:documentation>Tên đơn vị (USD;VND)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ma_DonVi" type="xs:string" nillable="true">
							<xs:annotation>
								<xs:documentation>Mã đơn vị (USD;VND)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="VSP" type="xs:boolean" nillable="true">
							<xs:annotation>
								<xs:documentation>VSP</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="PSC" type="xs:boolean" nillable="true">
							<xs:annotation>
								<xs:documentation>PSC</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="CT29">
							<xs:annotation>
								<xs:documentation>1. Sản lượng dầu, khí xuất bán</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="ma_donvitinh" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Mã đơn vị tính</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ten_donvitinh" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Tên đơn vị tính</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="giaTri" type="xs:decimal" nillable="true">
										<xs:annotation>
											<xs:documentation>Giá trị</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="CT30">
							<xs:annotation>
								<xs:documentation>2. Sản lượng dầu thô, khí thiên nhiên xuất bán quy đổi </xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="ma_donvitinh" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Mã đơn vị tính</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ten_donvitinh" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Tên đơn vị tính</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="giaTri" type="xs:decimal" nillable="true">
										<xs:annotation>
											<xs:documentation>Giá trị</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="CT31">
							<xs:annotation>
								<xs:documentation>3. Hệ số quy đổi</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="ma_donvitinh" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Mã đơn vị tính</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ten_donvitinh" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Tên đơn vị tính</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="giaTri" type="xs:decimal" nillable="true">
										<xs:annotation>
											<xs:documentation>Giá trị</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="CT32">
							<xs:annotation>
								<xs:documentation>4. Giá bán</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="ma_donvitinh" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Mã đơn vị tính</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ten_donvitinh" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Tên đơn vị tính</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="giaTri" type="xs:decimal" nillable="true">
										<xs:annotation>
											<xs:documentation>Giá trị</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="ct33" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>5. Doanh thu thực hiện</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct34" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>6. Thuế tài nguyên tạm tính phải nộp</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct35" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>7. Thuế xuất khẩu</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct36" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>8. Thuế đặc biệt tạm tính phải nộp</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct37" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>9. Số phụ thu tạm tính phải nộp</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct38" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>10. Các loại thuế khác (nếu có)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct39" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>11. Dầu, khí thu hồi chi phí</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct40" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>12. Chi phí để lại theo kế hoạch</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct41" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>13. Chi phí được trừ khác</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct42" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>14. Lợi nhuận trước thuế [42 VSP]=[33]-[34]-[35]-[36]-[37]-[38]-[40]-[41] hoặc [42 PSC]=[33]-[34]-[35]-[38]-[39]-[41] </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct43" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>15. Thuế suất thuế TNDN tạm nộp</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct44" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>16. Thuế TNDN tạm nộp [44] = [42 ] x [43]</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct45" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>17. Lãi dầu, khí sau thuế/Lợi nhuận sau thuế [45] = [42] - [44]</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct46" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>18.  Tỷ lệ chia cho nước chủ nhà</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct47" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>19. Tiền lãi dầu khí sau thuế của nước chủ nhà  [47] = [45] x [46]</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct48" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>20. Thu nhập khác/các khoản chia khác của nước chủ nhà</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct49" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>21. 1,5% phí quản lý, giám sát các Hợp đồng dầu khí [49] = [47] x 1,5%</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct50" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>22. Lãi dầu, khí nước chủ nhà còn lại của Hợp đồng dầu khí [50]=[47] +[48]-[49]</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct51" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>22.1 Tỷ lệ (%) nộp ngân sách</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct52" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>22.2 Tỷ lệ (%) để lại Công ty mẹ - PVN</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct53" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>22.3 Số tiền nộp trực tiếp vào ngân sách
[53 VSP] = ([51] x [47])+[48] hoặc [53 PSC] = [51]x([47]- [49])+ [48]
</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct54" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>22.4 Số tiền nộp về Công ty mẹ - PVN
[54 VSP] = [52] x [47] hoặc [54 PSC] = [52] x ([47]- [49])
</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct55" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>23. Tỷ giá quy đổi</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct56" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>1. Số tiền kết dư của phần dầu khí để lại</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct57" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>1.1 Tiền kết dư phần dầu khí để lại theo giá kế hoạch không sử dụng hết</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct58" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>1.2 Tiền kết dư phần chênh lệch giá dầu khí thực tế cao hơn giá kế hoạch </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct59" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>2. Số phụ thu tạm tính phải nộp</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct60" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>3. Thuế TNDN tạm nộp</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct61" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>4. Lợi nhuận sau thuế [61]=[56]-[59]-[60]</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct62" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>5. Tỷ lệ chia cho nước chủ nhà</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct63" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>6. Tiền lãi dầu, khí được chia của nước chủ nhà  [63]=[61]x[62]</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct64" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>6.1 Tỷ lệ (%) nộp ngân sách</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct65" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>6.2 Tỷ lệ (%) để lại Công ty mẹ - PVN</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct66" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>6.3 Số tiền nộp trực tiếp vào ngân sách
[66] = [63] x [64]</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct67" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>6.4 Số tiền nộp về Công ty mẹ - PVN
[67] = [63] x [65]</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct68" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>7. Tỷ giá quy đổi</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:redefine>
