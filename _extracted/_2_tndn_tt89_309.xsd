<xs:schema xmlns="http://kekhaithue.gdt.gov.vn/TKhaiThue" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://kekhaithue.gdt.gov.vn/TKhaiThue" elementFormDefault="qualified" attributeFormDefault="unqualified" version="2.0.7">
	<xs:redefine schemaLocation="../TKhaiThue_DBHC.xsd">
		<xs:complexType name="CTieuTKhaiChinhType">
			<xs:complexContent>
				<xs:extension base="CTieuTKhaiChinhType">
					<xs:sequence>
						<xs:element name="bds" type="xs:boolean" nillable="true">
							<xs:annotation>
								<xs:documentation>Bất động sản</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="tsk" type="xs:boolean" nillable="true">
							<xs:annotation>
								<xs:documentation>Tài sản khác</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="cnbds" type="xs:boolean" nillable="true">
							<xs:annotation>
								<xs:documentation>Tổ chức áp dụng phương pháp tỷ lệ trên doanh thu theo quy định của pháp luật về thuế TNDN có hoạt động chuyển nhượng bất động sản</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="bdgbds" type="xs:boolean" nillable="true">
							<xs:annotation>
								<xs:documentation>Cơ quan, tổ chức bán hoặc bán đấu giá bất động sản, tài sản khác là tài sản bảo đảm thi hành án, xử lý nợ</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ThongTinBenChuyenNhuong">
							<xs:annotation>
								<xs:documentation>1. Bên chuyển nhượng </xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="ct04" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>[04] Tên tổ chức chuyển nhượng</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct05" type="TINType" nillable="true">
										<xs:annotation>
											<xs:documentation>[05] Mã số thuế</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="ThongTinBenNhanChuyenNhuong">
							<xs:annotation>
								<xs:documentation>2. Bên nhận chuyển nhượng</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="ct06" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>[06] Tên tổ chức/cá nhân nhận chuyển nhượng</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct07" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>[07] Mã số thuế/số định danh cá nhân/giấy tờ định danh của cá nhân</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="CT08">
										<xs:annotation>
											<xs:documentation>[08] Địa chỉ</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="diaChi" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Địa chỉ</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="xaPhuong_ma" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Mã Xã/phường/đặc khu</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="xaPhuong_ten" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Tên Xã/phường/đặc khu</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="tinhTP_ma" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Mã Tỉnh/Thành phố</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="tinhTP_ten" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Tên Tỉnh/Thành phố</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="CT09">
										<xs:annotation>
											<xs:documentation>[09] Địa chỉ bất động sản được chuyển nhượng: </xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="ct09a" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>[09a] Số nhà, đường phố</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct09b_ma" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Mã Xã/phường/đặc khu</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct09b_ten" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Tên Xã/phường/đặc khu</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct09c_ma" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Mã Tỉnh/Thành phố</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct09c_ten" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Tên Tỉnh/Thành phố</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="BangChiTietBDS" nillable="true">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="NoiDungBatDongSan" nillable="true" maxOccurs="unbounded">
													<xs:complexType>
														<xs:sequence>
															<xs:element name="stt" type="xs:string" nillable="true">
																<xs:annotation>
																	<xs:documentation>Số thứ tự</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="so_hd" type="xs:string" nillable="true">
																<xs:annotation>
																	<xs:documentation>Số hợp đồng</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ngay_hd" type="xs:date" nillable="true">
																<xs:annotation>
																	<xs:documentation>Ngày hợp đồng</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ngay_congChung" type="xs:date" nillable="true">
																<xs:annotation>
																	<xs:documentation>Ngày UBND xã/phường/đặc khu hoặc văn phòng công chứng xác nhận</xs:documentation>
																</xs:annotation>
															</xs:element>
														</xs:sequence>
														<xs:attribute name="id" type="xs:string" use="required"/>
													</xs:complexType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="ThongTinCoQuanBanDauGia">
							<xs:annotation>
								<xs:documentation>3. Cơ quan, tổ chức bán hoặc bán đấu giá bất động sản, tài sản khác là tài sản bảo đảm </xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="ct10" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>[10] Tên cơ quan/tổ chức</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct11" type="TINType" nillable="true">
										<xs:annotation>
											<xs:documentation>[11] Mã số thuế của cơ quan/tổ chức</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="CT12">
										<xs:annotation>
											<xs:documentation>[12] Địa chỉ</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="diaChi" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Địa chỉ</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="xaPhuong_ma" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Mã Xã/phường/đặc khu</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="xaPhuong_ten" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Tên Xã/phường/đặc khu</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="tinhTP_ma" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Mã Tỉnh/thành phố</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="tinhTP_ten" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Tên Tỉnh/thành phố</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="ct16" type="xs:nonNegativeInteger" nillable="true">
							<xs:annotation>
								<xs:documentation>[16] Doanh thu từ hoạt động chuyển nhượng</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct17" type="xs:nonNegativeInteger" nillable="true">
							<xs:annotation>
								<xs:documentation>[17] Chi phí từ hoạt động chuyển nhượng</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct18" type="xs:nonNegativeInteger" nillable="true">
							<xs:annotation>
								<xs:documentation>[18] - Giá vốn </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct19" type="xs:nonNegativeInteger" nillable="true">
							<xs:annotation>
								<xs:documentation>[19] - Chi phí đền bù thiệt hại về đất</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct20" type="xs:nonNegativeInteger" nillable="true">
							<xs:annotation>
								<xs:documentation>[20] - Chi phí đền bù thiệt hại về hoa màu</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct21" type="xs:nonNegativeInteger" nillable="true">
							<xs:annotation>
								<xs:documentation>[21] - Chi phí cải tạo san lấp mặt bằng</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct22" type="xs:nonNegativeInteger" nillable="true">
							<xs:annotation>
								<xs:documentation>[22] - Chi phí đầu tư xây dựng kết cấu hạ tầng</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct23" type="xs:nonNegativeInteger" nillable="true">
							<xs:annotation>
								<xs:documentation>[23] - Chi phí khác</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct24" type="xs:long" nillable="true">
							<xs:annotation>
								<xs:documentation>[24] Thu nhập từ hoạt động chuyển nhượng
 ([24]=[16]-[17])</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct25" type="xs:decimal" nillable="true">
							<xs:annotation>
								<xs:documentation>[25] Thuế suất thuế TNDN</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ct26" type="xs:long" nillable="true">
							<xs:annotation>
								<xs:documentation>Thuế TNDN phải nộp ([26]=[24] x [25])</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:redefine>
</xs:schema>
