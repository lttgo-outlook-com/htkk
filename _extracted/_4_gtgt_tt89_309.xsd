													</xs:annotation>
												</xs:element>
												<xs:element name="ct33" type="xs:nonNegativeInteger" nillable="true">
													<xs:annotation>
														<xs:documentation>Doanh thu chưa có thuế giá trị gia tăng </xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct34" type="xs:nonNegativeInteger" nillable="true">
													<xs:annotation>
														<xs:documentation>Thuế suất</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct35" type="xs:nonNegativeInteger" nillable="true">
													<xs:annotation>
														<xs:documentation>Thuế giá trị gia tăng phải nộp
[35]= [33]x[34]</xs:documentation>
													</xs:annotation>
												</xs:element>
