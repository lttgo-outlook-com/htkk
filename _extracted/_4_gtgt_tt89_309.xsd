									<xs:element name="DoanhThuVaSoThuePNop">
										<xs:annotation>
											<xs:documentation>5.Doanh thu và số thuế phải nộp ([30]=[22]+[24]+[26]+[28]; [31]=[23]+[25]+[27]+[29])</xs:documentation>
										</xs:annotation>
