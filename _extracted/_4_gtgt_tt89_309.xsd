										<xs:annotation>
											<xs:documentation>Tổng doanh thu không chịu thuế [21a]: </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct21b" type="xs:nonNegativeInteger" nillable="true">
										<xs:annotation>
											<xs:documentation>Tổng doanh thu chịu thuế suất 0% [21b]:</xs:documentation>
										</xs:annotation>
									</xs:element>
