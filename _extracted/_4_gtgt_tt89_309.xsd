											<xs:documentation>Doanh thu và số thuế phải nộp
([36]=∑[33]]; [37]=∑[35])</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="ct36" type="xs:nonNegativeInteger" nillable="true">
													<xs:annotation>
														<xs:documentation>Doanh thu chưa có thuế giá trị gia tăng</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct37" type="xs:nonNegativeInteger" nillable="true">
													<xs:annotation>
