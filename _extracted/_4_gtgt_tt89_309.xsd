																<xs:annotation>
																	<xs:documentation>Thuế GTGT được giảm</xs:documentation>
																</xs:annotation>
															</xs:element>
														</xs:sequence>
														<xs:attribute name="ID" type="xs:string"/>
													</xs:complexType>
												</xs:element>
												<xs:element name="tongCongGiaTriHHDV" type="xs:long" nillable="true">
