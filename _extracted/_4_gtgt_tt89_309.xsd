						<xs:element name="KhaiThueTPPTTTDT">
							<xs:annotation>
								<xs:documentation>A. Khai thuế theo phương pháp trực tiếp trên doanh thu/khai thuế đối với hoạt động bán tài sản bảo đảm thi hành án của Cơ quan thi hành án /khai thuế đối với trường hợp đề nghị cơ quan thuế cấp hóa đơn điện tử theo từng lần phát sinh là hóa đơn bán hàng theo quy định của pháp luật về hóa đơn điện tử</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="PPhoiCCapHHoa">
										<xs:annotation>
											<xs:documentation>1. Phân phối, cung cấp hàng hoá ([23]=[22]x1%)</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="ct22" type="xs:long" nillable="true">
													<xs:annotation>
														<xs:documentation>Doanh thu chịu thuế giá trị gia tăng</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct23" type="xs:long" nillable="true">
													<xs:annotation>
														<xs:documentation>Thuế giá trị gia tăng phải nộp</xs:documentation>
