{
  "agent": "coordinator",
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "9",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "HAIKU_CONTEXT_BLOCK_TOKENS": "65000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "20000",
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "HAIKU_CONTEXT_GUARD_LOG": ".claude/guard.log"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/haiku_context_guard.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/subagent_log.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/statusline.sh",
    "refreshInterval": 60
  }
}
